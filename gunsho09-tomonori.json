 "poems": [
  {
   "seq": "1",
   "text": "水の面にあや吹みたる春風や池の氷をけさはとくらん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "花のかを風のたよりにたくへてそ鶯さそふしるへにはやる",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "君ならてたれにかみせむ梅の花色をもかをもしる人そしる",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "色もかも昔なからにさくらめと年ふる人そあらたまりける",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "みよしのゝ山へにさける櫻花雪かとのみそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "久かたの光のとけき春の日にしつ心なく花のちるらん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "雪ふれは木〓とに花そ咲にけるいつれを梅とわきてをらまし",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "音羽山けさこえくれは子規梢はるかにいまそなくなる",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "珍しき聲ならなくに郭公こゝらの年をあかすも有哉",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "五月雨に物おもひをれは時鳥夜深く鳴ていつちゆくらん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "夜やくらき道やまとへる時鳥我やとにしもおりはへてなく",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "夕されはほたるよりけにもゆれとも光みれはや人のつれなき",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "けふよりは天の河浪あせななんそよみともなくたゝ渡りなん",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あまの川流れてこふる七夕の淚なるらし秋のしら露",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "天の川せゝの白浪たかけれとたゝわたりしぬまつにくるしみ",
   "kana": "",
   "speaker": "",
   "page": 300,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "天川戀しき瀨にそわたりぬるたきつ涙に袖はぬれつゝ",
   "kana": "",
   "speaker": "紀友則集",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "銀川あさせ白浪たとりつゝわたりはてねはあけそしにける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "聲たてゝ鳴そしぬへき秋霧に友まとはせる鹿にはあらねと",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "誰きけは聲高砂に棹鹿のなか〓〓しよをひとりなくらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うちはへてかけとそ賴む嶺の松色とる秋の風にうつるな",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夕されはさほの河原の河霧に友まとはせる千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "秋風に初かりかねそ聞ゆなるたか玉章をかけてきつらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "誰ためのにしきなれはか秋霧のさほの山へを立ちかくすらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "花みつゝ人まつをりは白妙の袖かとのみそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "露なから折てかゝさん菊の花老せぬ秋の久しかるへく",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "かくはかりもみつる色のこけれはや錦たつたの山といふらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "みる〓とに秋にも有かなたつた姫紅葉そむとや山もきるらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "初時雨ふれは山へそおもほゆれ何れのかたかまつもみつらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "から衣たつたの山のもみち葉は物思ふ人のなみたなりけり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "一もとゝおもひしきくをおほ澤の池の底にはたれか植けん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "春霞たな引山の櫻花みれともあかぬ君にもあるかな",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "我戀をしのひかねては足引の山たちはなの色に出ぬへし",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "よひのまもはかなくみゆる夏虫にまとひ增れる戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "蟬の聲きけはかなしな夏衣うすくや人のならんとおもへは",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "紅の色にはいてしかくれぬのしたに忍ひて戀はしぬとも",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "玉かつくあまならねともわたつ海の底ひも知らす思ひつる哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "みるもなくめもなき海の島にいてゝかへす〓〓も恨みつる哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "我心いつにならひてみぬ人の思ひやりつゝ戀しかるらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "我宿の菊のかきねにおく霜のきえかへりてそ戀しかりける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "思ひてもはかなき物は吹かせのおとにもきかぬ戀にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "秋風はみを分てしもふかなくに人の心のそらになるらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さゝの葉におく霜よりも獨ぬる我衣手そさえまさりける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "河のせになひく玉ものみかくれて人にしられぬ戀もするかな",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "よひ〓〓におきてわかぬるから衣かけて思はぬ時のまそなき",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "東路のさやの中山なか〓〓になにしに人を思ひそめけむ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "しき妙の枕のしたは海なれと人をみるめは生すそありける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "年をへてきえめ思ひはありなから冬の袂は猶氷けり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "〓とにいてゝいはぬ計そ水無瀨川したに通ひて戀しき物を",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "命やは何そは露のあたものをあふにしかへはをしからなくに",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "立ち歸り思ひいつれはそのかみのふりにし〓とを忘れさりけり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "下にのみ思へはくるし玉の〓の絕てみたれん人なとかめそ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "水の沫の消てうきみとしりなから流れても猶たのまるゝ哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "うきなからきえせぬ沫と成なゝん流れてとたに賴れぬみは",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "雲もなくなきたる朝の我なれや厭はれてのみよをはへぬらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "今迄になとかは花のさかすしてよそとせまてに年きりのする",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "はる〓〓の數はまとはす有なから花さかぬ木をなにゝ植けむ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "蟬のはのよるの衣はうすけれとうつりかこくも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "故里はみしこともあらすをのゝえの朽し所そ戀しかりける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "下の帶の道はかた〓〓別るとも行めくりてもあはんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "枝もはも移ろふ秋の菊みれははてはかけなくなりぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "雫もて齡のふてふ花なれは千世の秋にそかけはみつらん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "ことならは言のはさへもきえなゝんみれは涙の瀧まさりけり",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "ねてもみゆねてもみえ鳬大かたは空蟬のよそ夢にはありける",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "とりもあへぬとしは水にや流るてふ花の心のあさく成行",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "白露を玉にぬくとやさゝかにの花にもはにもいとをみなへし",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "朝霧を分そほらつゝ花みんと今そ山へをみなへしりぬる",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "みよしのゝ吉野の山に浮ひ出つるあはをか玉のきゆとみゆ覽",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "あきちかう野は成にけり白露のおける草はの色かはりゆく",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "我宿の花ふみちらす鳥うたん野はなけれはやこゝにしもくる",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "年をへて君にのみ社ねすみつれこと腹にやはこをはなすへき",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "君といへはみまれみすまれふしのねの珍しけなくもゆる我戀",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "我を君思ひつくはの山のはにいもといりなはかへらさらなん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "朝霧はけさはなたちそさは山のはゝその紅葉よそにてもみん",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "池水や氷とつらむ芦鴨の夜深く聲のさはくなる哉",
   "kana": "",
   "speaker": "",
   "page": 301,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
